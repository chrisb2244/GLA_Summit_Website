# Credentials for the HOSTED test Supabase project (gla-summit-test), used by
#   npm run db:seed:avatars:remote
# to seed placeholder avatars/icons into that project's storage. Copy to
# frontend/.env.test.remote (git-ignored) and fill from the test project's
# dashboard (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL="https://<test-ref>.supabase.co"
SECRET_SUPABASE_SERVICE_KEY="<test project service_role key>"
