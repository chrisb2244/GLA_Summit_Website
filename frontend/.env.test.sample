# Local Supabase URL and Anon Key
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:55321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key>"
SECRET_SUPABASE_SERVICE_KEY="<service_role key>"

# Add enviroment variables for test users - these are generated by the seeding process
# Testing emails for auth setup
TEST_ADMIN_EMAIL=christian27@test.email
TEST_ORGANIZER_EMAIL=sreejith28@test.email
TEST_PRESENTER_EMAIL=kamalakannan35@test.email
TEST_ATTENDEE_EMAIL=maciej6@test.email

# API URL for the mock email sending service used in tests
# ..324 is usually the address for Mailpit's API. ...325 is the SMTP port for sending.
TEST_MAIL_API_URL='http://127.0.0.1:55324'

# testmail.app — set BOTH to route email lookups through the testmail.app
# GraphQL API instead of the local Mailpit inbox (e.g. when running specs
# against a deployed site). Generated test addresses always look like
# "{namespace}.{tag}@inbox.testmail.app"; when TESTMAIL_NAMESPACE is unset the
# namespace defaults to "test" and lookups use the local inbox, so locally you
# can leave both unset. Get these from your testmail.app dashboard.
# TESTMAIL_NAMESPACE=
# TESTMAIL_API_KEY=

# HMAC key for copresenter invite tokens — must match COPRESENTER_INVITE_KEY in .env.local
# COPRESENTER_INVITE_KEY=