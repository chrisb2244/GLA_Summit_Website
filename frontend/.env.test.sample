# Local Supabase URL and Anon Key
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:55321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key>"
SECRET_SUPABASE_SERVICE_KEY="<service_role key>"

# Add enviroment variables for test users - these are generated by the seeding process
# Testing emails for auth setup
TEST_ADMIN_EMAIL=christian27@test.email
TEST_ORGANIZER_EMAIL=sreejith28@test.email
TEST_PRESENTER_EMAIL=kamalakannan35@test.email
TEST_ATTENDEE_EMAIL=maciej6@test.email

# Local mail catcher (Supabase Inbucket/Mailpit) used by the tests. Two distinct
# endpoints:
#   • …324 = HTTP API   — Playwright reads delivered mail from here.
#   • …325 = SMTP port  — the app sends mock-mode mail here.
MAILPIT_API_URL='http://127.0.0.1:55324'
MAILPIT_SMTP_URL='http://127.0.0.1:55325'

# Shared secret for the submission-outcome webhook. Set this to the SAME value as
# SECRET_SUBMISSION_OUTCOME_TOKEN in .env.local so the review-force-conclusion
# email test can POST /api/submission-outcome. If unset, that email test skips.
# SECRET_SUBMISSION_OUTCOME_TOKEN=

# testmail.app — set BOTH to route email lookups through the testmail.app
# GraphQL API instead of the local Mailpit inbox (e.g. when running specs
# against a deployed site). Generated test addresses always look like
# "{namespace}.{tag}@inbox.testmail.app"; when TESTMAIL_NAMESPACE is unset the
# namespace defaults to "test" and lookups use the local inbox, so locally you
# can leave both unset. Get these from your testmail.app dashboard.
# TESTMAIL_NAMESPACE=
# TESTMAIL_API_KEY=

# HMAC key for copresenter invite tokens — must match COPRESENTER_INVITE_KEY in .env.local
# COPRESENTER_INVITE_KEY=

# Information about the seeded "concluder" user, which is used to test the submission-outcome webhook. 
# The seeded user is created by the seeding process and has a known ID and email address. 
# These values are used in the tests to simulate a concluder user posting to the webhook.
TEST_CONCLUDER_USER_ID=8a52cd4e-a250-4dba-b799-f38b6e34c75f
TEST_CONCLUDER_EMAIL=christian27@test.email
TEST_CONCLUDER_FIRST_NAME=Christian
TEST_CONCLUDER_LAST_NAME=Butcher