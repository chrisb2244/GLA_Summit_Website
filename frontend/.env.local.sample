NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"

# Next.js 15 refuses to fetch images from private/loopback IPs via the image
# optimizer (SSRF protection). Set this to bypass it locally. Vercel deploys
# never have .env.local, so this never affects production.
NEXT_IMAGE_UNOPTIMIZED=true
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key>"
SECRET_SUPABASE_SERVICE_KEY="<service_role key>"

# Additionally, set the following environment variable to remove a requirement for the email server keys
USE_MOCK_EMAIL=true

# Add enviroment variables for test users - these are generated by the seeding process
# Testing emails for auth setup
TEST_ADMIN_EMAIL=Christian27@test.email
TEST_ORGANIZER_EMAIL=Sreejith28@test.email
TEST_PRESENTER_EMAIL=Kamalakannan35@test.email
TEST_ATTENDEE_EMAIL=Maciej6@test.email

# Add the sender line for emails
EMAIL_FROM_MG="GLA Summit Organizers <web@glasummit.org>"
MAILGUN_SENDING_KEY="<mailgun sending key>"

# A 'key' used to create tickets
TICKET_KEY="thisisastrongkey!!"

# A 'key' used to sign co-presenter invite tokens.
# Leave this UNSET unless you are enabling the accept/decline workflow
# (COPRESENTER_INVITE_WORKFLOW in configConstants.ts). While unset, token
# verification fails closed, so the invite route/actions cannot be exercised.
# Never use a shared/placeholder value: generate a unique one with
#   openssl rand -hex 32
# COPRESENTER_INVITE_KEY=