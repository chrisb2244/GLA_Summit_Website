NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:55321"

# Next.js 16 refuses to fetch images from private/loopback IPs via the image
# optimizer (SSRF protection). Local Supabase storage is on http://127.0.0.1,
# so allow it here to keep the optimizer (/_next/image) running locally as it
# does in production. Vercel deploys never have .env.local, so the secure
# default (false) is kept there.
NEXT_IMAGE_ALLOW_LOCAL_IP=true
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key>"
SECRET_SUPABASE_SERVICE_KEY="<service_role key>"

# Additionally, set the following environment variable to remove a requirement for the email server keys
USE_MOCK_EMAIL=true
# Local mail catcher (Supabase Inbucket/Mailpit). Two distinct endpoints:
#   • …324 = HTTP API   — Playwright reads delivered mail from here.
#   • …325 = SMTP port  — the app sends mock-mode mail here.
MAILPIT_API_URL='http://127.0.0.1:55324'
MAILPIT_SMTP_URL='http://127.0.0.1:55325'

# Add the sender line for emails
EMAIL_FROM_MG="GLA Summit Organizers <web@glasummit.org>"
MAILGUN_SENDING_KEY="<mailgun sending key>"

# A 'key' used to create tickets
TICKET_KEY="thisisastrongkey!!"

# Shared secret authenticating the Supabase database webhook that drives
# on-demand cache revalidation (POST /api/revalidate). The webhook must send
# this value in the `x-revalidate-secret` header. While unset the route fails
# closed (503) and rejects all callers.
#
# For LOCAL dev keep this exact value: supabase/seeds/seed.sql seeds the matching
# Vault secret (revalidate_token) with the same string on `npm run db:reset`, so
# the header check passes with no manual setup. Deployed environments set a unique
# value (openssl rand -hex 32) in BOTH the app env and that DB's Vault.
SECRET_REVALIDATE_TOKEN="local-dev-revalidate-secret"

# Shared secret authenticating the Supabase database trigger that POSTs
# automated submission outcomes (accept/decline) to POST /api/submission-outcome.
# The trigger sends this value in the `x-submission-outcome-secret` header. While
# unset the route fails closed (503). The outcome row is still written by the
# trigger regardless; this only gates the app-side follow-up (outcome emails).
#
# For LOCAL dev keep this exact value: supabase/seeds/seed.sql seeds the matching
# Vault secret (submission_outcome_token) with the same string on
# `npm run db:reset`. Deployed environments set a unique value (openssl rand
# -hex 32) in BOTH the app env and that DB's Vault.
SECRET_SUBMISSION_OUTCOME_TOKEN="local-dev-submission-outcome-secret"

# A 'key' used to sign co-presenter invite tokens.
# Leave this UNSET unless you are enabling the accept/decline workflow
# (COPRESENTER_INVITE_WORKFLOW in configConstants.ts). While unset, token
# verification fails closed, so the invite route/actions cannot be exercised.
# Never use a shared/placeholder value: generate a unique one with
#   openssl rand -hex 32
# COPRESENTER_INVITE_KEY=