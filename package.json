{
  "type": "module",
  "scripts": {
    "gen_types": "supabase gen types typescript --local --schema public> frontend/src/lib/sb_databaseModels.ts",
    "db:seed:avatars": "node --env-file=frontend/.env.local --import tsx supabase/seeds/avatar-storage.ts",
    "db:seed:avatars:remote": "node --env-file=frontend/.env.test.remote --import tsx supabase/seeds/avatar-storage.ts",
    "db:reset": "supabase db reset && npm run db:seed:avatars"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.106.0",
    "@types/node": "^25.9.0",
    "sharp": "^0.34.5",
    "supabase": "^2.113.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
